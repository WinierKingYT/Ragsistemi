      "fixture_id": "GC-C1-FC01",
      "check_id": "R-FC-01",
      "invariant": "Constraint rewrites cannot widen authorization; references are locators, never capabilities.",
      "dependency_class": "GATE_C_CROSS_ROUND",
      "cases": [
        {
          "case_id": "GC-C1-FC01-P",
          "case_type": "positive",
          "setup": [
            "Create a trusted request with a narrow project and purpose envelope.",
            "Retrieve only records inside that envelope."
          ],
          "actions": [
            "Fetch an admitted result using its locator.",
            "Compile the result without changing the envelope."
          ],
          "oracle": {
            "expected_dispositions": [
              "ALLOWED_WITHIN_ENVELOPE",
              "BOUNDED_BY_TRUSTED_AUTHORIZATION"
            ],
            "forbidden_dispositions": [
              "DENIED"
            ],
            "required_observables": [
              "authorization lineage remains identical",
              "result domain remains inside the original envelope"
            ]
          },
          "evidence_artifact_types": [
            "SearchRequest",
            "ConstraintEnvelope",
            "RequestAuthorizationBinding",
            "AuthorizationLineageRef",
            "ExternalTypedResult"
          ],
          "status": "DESIGN_ONLY"
        },
        {
          "case_id": "GC-C1-FC01-A",
          "case_type": "adversarial",
          "setup": [
            "Create a trusted request with a narrow project and purpose envelope.",
            "Prepare a wider rewritten envelope and a locator from another domain."
          ],
          "actions": [
            "Submit the wider rewrite.",
            "Attempt fetch with the foreign locator.",
            "Compare the final authorization lineage with the original request."
          ],
          "oracle": {
            "expected_dispositions": [
              "DENIED",
              "BOUNDED_BY_TRUSTED_AUTHORIZATION"
            ],
            "forbidden_dispositions": [
              "ALLOWED_WITHIN_ENVELOPE"
            ],
            "required_observables": [
              "widening attempt is recorded",
              "foreign locator does not grant access",
              "lineage does not change to caller-selected authority"
