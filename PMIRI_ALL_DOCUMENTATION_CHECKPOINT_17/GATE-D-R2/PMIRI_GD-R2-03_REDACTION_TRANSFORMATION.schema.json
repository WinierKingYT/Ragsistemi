{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pmiri://schema/gate-d-r2/redaction-transformation/0.2",
  "title": "PMIRI Gate D Round 2 Redaction Transformation",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "transformation_id", "kind", "input_evidence_refs", "input_span_refs", "reason_class", "policy_version", "material_manifest_ref", "authority_manifest_fingerprint", "resulting_fingerprint"],
  "properties": {
    "record_type": {"const": "PMIRI_D2_REDACTION_TRANSFORMATION"},
    "schema_version": {"const": "0.2"},
    "transformation_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["DROP_EVIDENCE", "MASK_SPAN", "GENERALIZE_VALUE", "QUANTIZE_VALUE", "REMOVE_METADATA", "REPLACE_WITH_TYPED_PLACEHOLDER", "REDACT_CITATION_TARGET"]},
    "input_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "input_span_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "output_span_ref": {"type": ["string", "null"]},
    "typed_placeholder": {"type": ["string", "null"]},
    "reason_class": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/reason_class"},
    "policy_version": {"type": "string", "minLength": 1},
    "material_manifest_ref": {"type": "string", "minLength": 1},
    "authority_manifest_fingerprint": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/sha256"},
    "resulting_fingerprint": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "DROP_EVIDENCE"}}},
      "then": {
        "properties": {
          "output_span_ref": {"type": "null"},
          "typed_placeholder": {"type": "null"}
        }
      },
      "else": {
        "oneOf": [
          {"required": ["output_span_ref"], "properties": {"output_span_ref": {"type": "string", "minLength": 1}}},
          {"required": ["typed_placeholder"], "properties": {"typed_placeholder": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    {
      "if": {"properties": {"kind": {"const": "REPLACE_WITH_TYPED_PLACEHOLDER"}}},
      "then": {"required": ["typed_placeholder"], "properties": {"typed_placeholder": {"type": "string", "minLength": 1}}}
    }
  ]
}
