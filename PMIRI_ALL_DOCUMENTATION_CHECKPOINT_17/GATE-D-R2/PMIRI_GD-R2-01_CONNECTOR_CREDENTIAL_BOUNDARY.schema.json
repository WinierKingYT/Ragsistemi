{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pmiri://schema/gate-d-r2/connector-credential-boundary/0.2",
  "title": "PMIRI Gate D Round 2 Connector Credential Boundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "boundary_id", "connector_subject_ref", "operation", "audience", "operation_scope", "injection_channel", "visibility_prohibitions", "valid_from", "valid_until", "credential_epoch", "rotation_ref", "revocation_ref", "source_ref", "authority_manifest_fingerprint", "status", "boundary_fingerprint"],
  "properties": {
    "record_type": {"const": "PMIRI_D2_CONNECTOR_CREDENTIAL_BOUNDARY"},
    "schema_version": {"const": "0.2"},
    "boundary_id": {"type": "string", "minLength": 1},
    "connector_subject_ref": {"type": "string", "minLength": 1},
    "operation": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/operation"},
    "audience": {"type": "object", "additionalProperties": false, "required": ["connector_process_ref", "destination_ref"], "properties": {"connector_process_ref": {"type": "string", "minLength": 1}, "destination_ref": {"type": "string", "minLength": 1}}},
    "operation_scope": {"type": "array", "minItems": 1, "items": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/operation"}, "uniqueItems": true},
    "injection_channel": {"enum": ["PROCESS_MEMORY_HANDLE", "SIDECAR_SECRET_MOUNT", "DELEGATED_TOKEN_EXCHANGE", "EXPLICIT_PROXY_CREDENTIAL"]},
    "visibility_prohibitions": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"enum": ["SECRET_VALUE_TO_PROVIDER_MODEL", "SECRET_VALUE_TO_FETCHED_CONTENT", "SECRET_VALUE_TO_CALLER_CONTENT", "SECRET_VALUE_TO_LOGS", "SECRET_VALUE_TO_ERROR_PAYLOAD", "SECRET_VALUE_TO_CANONICAL_ARTIFACT"]}},
    "valid_from": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/timestamp"},
    "valid_until": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/timestamp"},
    "credential_epoch": {"type": "integer", "minimum": 0},
    "rotation_ref": {"type": "string", "minLength": 1},
    "revocation_ref": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "authority_manifest_fingerprint": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/sha256"},
    "status": {"enum": ["ACTIVE", "EXPIRED", "REVOKED", "INVALID"]},
    "boundary_fingerprint": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/sha256"}
  }
}
