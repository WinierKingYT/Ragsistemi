{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pmiri://schema/gate-d-r2/trust-assertion/0.2",
  "title": "PMIRI Gate D Round 2 Trust Assertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "trust_assertion_id", "subject", "purpose", "allowed_material_classes", "allowed_features", "allowed_zones", "issuer", "evidence_refs", "policy_version", "observed_at", "valid_until", "status", "assertion_fingerprint"],
  "properties": {
    "record_type": {"const": "PMIRI_D2_TRUST_ASSERTION"},
    "schema_version": {"const": "0.2"},
    "trust_assertion_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id"],
      "properties": {
        "subject_type": {"enum": ["provider", "service", "model", "feature", "connector", "endpoint", "origin", "subprocessor"]},
        "subject_id": {"type": "string", "minLength": 1},
        "parent_subject_ref": {"type": "string", "minLength": 1}
      }
    },
    "purpose": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/purpose"},
    "allowed_material_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_features": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_zones": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "issuer": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "policy_version": {"type": "string", "minLength": 1},
    "observed_at": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/timestamp"},
    "valid_until": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/timestamp"},
    "revocation_ref": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACTIVE", "EXPIRED", "REVOKED", "SUPERSEDED", "INVALID"]},
    "assertion_fingerprint": {"$ref": "pmiri://schema/gate-d-r2/decision-vocabulary/0.2#/$defs/sha256"}
  }
}
